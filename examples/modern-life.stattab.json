  "schemas": [
    {
      "name": "Example: Modern life",
      "instructions": "Change stats gradually: most messages should move a stat by only 1 to 5 points, and many should change nothing. Reserve large swings for major events such as a betrayal, a confession or a windfall. Only update the stats that the latest message actually affects, and keep text values short.",
      "entities": [
        {
          "id": "e_char",
          "name": "{{char}}",
          "description": "How {{char}} is doing right now.",
          "vars": [
            {
              "id": "v_trust",
              "name": "Trust",
              "type": "number",
              "description": "{{char}}'s trust in {{user}}. Rises slowly through honesty and reliability, and drops sharply after lies or betrayals.",
              "startsUnset": false,
              "hideFromModel": false,
              "min": 0,
              "max": 100,
              "format": "bar",
              "symbol": "$",
              "maxLength": null,
              "initial": 40
            },
            {
              "id": "v_energy",
              "name": "Energy",
              "type": "number",
              "description": "{{char}}'s physical and mental energy. Drains with stress, long days and skipped meals; recovers with sleep, food and downtime.",
              "startsUnset": false,
              "hideFromModel": false,
              "min": 0,
              "max": 100,
              "format": "percent",
              "symbol": "$",
              "maxLength": null,
              "initial": 80
            },
            {
              "id": "v_mood",
              "name": "Mood",
              "type": "text",
