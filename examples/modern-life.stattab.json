              "hideFromModel": false,
              "max": null,
              "min": null,
              "format": "plain",
              "symbol": "$",
              "maxLength": 40,
              "initial": "calm"
            },
            {
              "id": "v_opinion",
              "name": "Opinion of {{user}}",
              "type": "text",
              "description": "One sentence on what {{char}} currently thinks of {{user}}. Update it when something changes their view.",
              "startsUnset": true,
              "hideFromModel": false,
              "max": null,
              "min": null,
              "format": "plain",
              "symbol": "$",
              "maxLength": 120,
              "initial": ""
            }
          ]
        },
        {
          "id": "e_user",
          "name": "{{user}}",
          "description": "How {{user}} is doing right now.",
          "vars": [
            {
              "id": "v_cash",
              "name": "Cash",
              "type": "number",
              "description": "{{user}}'s spendable money. Falls when {{user}} pays for things and rises when they are paid. A coffee costs about 450.",
