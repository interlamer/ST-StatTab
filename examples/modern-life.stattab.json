              "hideFromModel": false,
              "min": 0,
              "max": null,
              "format": "money",
              "symbol": "$",
              "maxLength": null,
              "initial": 150000
            },
            {
              "id": "v_stress",
              "name": "Stress",
              "type": "number",
              "description": "{{user}}'s stress, from 0 (completely calm) to 10 (overwhelmed). Rises with deadlines, conflict and lack of sleep; falls with rest, support and good news.",
              "startsUnset": false,
              "hideFromModel": false,
              "min": 0,
              "max": 10,
              "format": "bar",
              "symbol": "$",
              "maxLength": null,
              "initial": 3
            }
          ]
        },
        {
          "id": "e_rel",
          "name": "{{char}} and {{user}}",
          "description": "Where things stand between them.",
          "vars": [
            {
              "id": "v_status",
              "name": "Status",
              "type": "text",
